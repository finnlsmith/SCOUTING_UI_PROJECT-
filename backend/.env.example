# ============================================
# Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# AWS Configuration
# -----------------
# AWS region where your S3 bucket is located
AWS_REGION=us-east-2

# S3 bucket name containing match data files
S3_BUCKET_NAME=capstone-soccer-data

# AWS credentials for S3 access
# Get these from AWS IAM console
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# API Configuration (Optional)
# ----------------------------
# Port for local development (default: 8000)
# PORT=8000

# Environment (development/production)
# ENVIRONMENT=development

# CORS Origins (Optional)
# -----------------------
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Logging Configuration (Optional)
# --------------------------------
# LOG_LEVEL=INFO

# Notes:
# ------
# - Never commit your actual .env file to git
# - Add .env to .gitignore
# - For production, use environment variables from your hosting platform (e.g., Render, Heroku)
# - Ensure AWS credentials have read access to the S3 bucket
# - Keep AWS_SECRET_ACCESS_KEY secure and never share it

