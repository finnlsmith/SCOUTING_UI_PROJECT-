# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# AWS Configuration
AWS_REGION=us-east-2
S3_BUCKET_NAME=capstone-soccer-data
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# CORS Configuration
# Comma-separated list of allowed origins (no spaces after commas)
# For production, include your frontend URL(s)
# For local development, include http://localhost:3000 and http://localhost:5173
# Example: CORS_ORIGINS=https://your-frontend.com,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=https://columbia-msds-f25-soccer-frontend.onrender.com,https://columbia-msds-f25-soccer.onrender.com,http://localhost:3000,http://localhost:5173

# Redis Configuration (optional - for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
