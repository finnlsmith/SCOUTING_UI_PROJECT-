						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"message\": \"Test error message\",\n  \"stack\": \"Error: Test error\\n    at Component...\",\n  \"componentStack\": \"    in TestComponent\\n    in App\",\n  \"url\": \"http://localhost:3000/test\",\n  \"userAgent\": \"PostmanRuntime/7.x\",\n  \"time\": \"2024-01-15T10:30:00.000Z\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/client-error",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"client-error"
							]
						},
						"description": "Test endpoint for logging client-side errors"
					},
					"response": []
				}
			]
		},
