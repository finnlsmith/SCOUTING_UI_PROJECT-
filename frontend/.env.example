# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# Backend API URL
# Required in production. For local development, defaults to http://localhost:8000/api if not set
# Example for production: REACT_APP_BACKEND_URL=https://your-backend-api.com/api
# Example for local: REACT_APP_BACKEND_URL=http://localhost:8000/api
# Note: In production builds, this MUST be set or the app will fail
REACT_APP_BACKEND_URL=http://localhost:8000/api
